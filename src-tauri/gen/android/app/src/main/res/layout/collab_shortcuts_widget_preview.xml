<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/CollabWidgetPreviewShell">

    <TextView
        style="@style/CollabWidgetPreviewHeader"
        android:layout_width="match_parent"
        android:layout_weight="0"
        android:text="Shortcuts" />

    <LinearLayout
        style="@style/CollabWidgetPreviewCard"
        android:layout_marginTop="9dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="9dp"
            android:text="📄"
            android:textColor="#A174FF"
            android:textSize="13sp" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                style="@style/CollabWidgetPreviewCardTitle"
                android:text="Roadmap" />
            <TextView
                style="@style/CollabWidgetPreviewCardDetail"
                android:text="Note · Team vault" />
        </LinearLayout>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="★"
            android:textColor="#808693"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        style="@style/CollabWidgetPreviewCard"
        android:layout_marginTop="6dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="9dp"
            android:text="🗂"
            android:textColor="#A174FF"
            android:textSize="13sp" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                style="@style/CollabWidgetPreviewCardTitle"
                android:text="Sprint board" />
            <TextView
                style="@style/CollabWidgetPreviewCardDetail"
                android:text="Board · Team vault" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
