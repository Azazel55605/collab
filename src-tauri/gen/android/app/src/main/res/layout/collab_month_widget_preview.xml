<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/collab_widget_preview_background"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="August"
            android:textColor="#E4E8EF"
            android:textSize="16sp"
            android:textStyle="bold" />
        <TextView android:layout_width="30dp" android:layout_height="wrap_content" android:gravity="center" android:text="‹" android:textColor="#808693" android:textSize="21sp" />
        <TextView android:layout_width="30dp" android:layout_height="wrap_content" android:gravity="center" android:text="›" android:textColor="#808693" android:textSize="21sp" />
        <TextView
            android:layout_width="40dp"
            android:layout_height="32dp"
            android:background="@drawable/collab_widget_preview_accent"
            android:gravity="center"
            android:text="+"
            android:textColor="#0C0F16"
            android:textSize="21sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:orientation="horizontal">
        <TextView style="@style/CollabWidgetPreviewWeekday" android:text="M" />
        <TextView style="@style/CollabWidgetPreviewWeekday" android:text="T" />
        <TextView style="@style/CollabWidgetPreviewWeekday" android:text="W" />
        <TextView style="@style/CollabWidgetPreviewWeekday" android:text="T" />
        <TextView style="@style/CollabWidgetPreviewWeekday" android:text="F" />
        <TextView style="@style/CollabWidgetPreviewWeekday" android:text="S" />
        <TextView style="@style/CollabWidgetPreviewWeekday" android:text="S" />
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
        <LinearLayout style="@style/CollabWidgetPreviewDay"><TextView style="@style/CollabWidgetPreviewDayNumber" android:text="27" android:textColor="#646A75" /></LinearLayout>
        <LinearLayout style="@style/CollabWidgetPreviewDay"><TextView style="@style/CollabWidgetPreviewDayNumber" android:text="28" android:textColor="#646A75" /></LinearLayout>
        <LinearLayout style="@style/CollabWidgetPreviewDay"><TextView style="@style/CollabWidgetPreviewDayNumber" android:text="29" android:textColor="#646A75" /></LinearLayout>
        <LinearLayout style="@style/CollabWidgetPreviewDay"><TextView style="@style/CollabWidgetPreviewDayNumber" android:text="30" android:textColor="#646A75" /><TextView style="@style/CollabWidgetPreviewChip" android:background="@drawable/collab_widget_preview_chip_violet" android:text="Planning" /></LinearLayout>
        <LinearLayout style="@style/CollabWidgetPreviewDay"><TextView style="@style/CollabWidgetPreviewDayNumber" android:text="31" android:textColor="#646A75" /></LinearLayout>
        <LinearLayout style="@style/CollabWidgetPreviewDay"><TextView style="@style/CollabWidgetPreviewDayNumber" android:background="@drawable/collab_widget_preview_accent" android:text="1" android:textColor="#0C0F16" /></LinearLayout>
        <LinearLayout style="@style/CollabWidgetPreviewDay"><TextView style="@style/CollabWidgetPreviewDayNumber" android:text="2" /></LinearLayout>
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
        <LinearLayout style="@style/CollabWidgetPreviewDay"><TextView style="@style/CollabWidgetPreviewDayNumber" android:text="3" /><TextView style="@style/CollabWidgetPreviewChip" android:background="@drawable/collab_widget_preview_chip_rose" android:text="Design" /></LinearLayout>
        <LinearLayout style="@style/CollabWidgetPreviewDay"><TextView style="@style/CollabWidgetPreviewDayNumber" android:text="4" /></LinearLayout>
        <LinearLayout style="@style/CollabWidgetPreviewDay"><TextView style="@style/CollabWidgetPreviewDayNumber" android:text="5" /></LinearLayout>
        <LinearLayout style="@style/CollabWidgetPreviewDay"><TextView style="@style/CollabWidgetPreviewDayNumber" android:text="6" /><TextView style="@style/CollabWidgetPreviewChip" android:background="@drawable/collab_widget_preview_chip_cyan" android:text="Workshop" /></LinearLayout>
        <LinearLayout style="@style/CollabWidgetPreviewDay"><TextView style="@style/CollabWidgetPreviewDayNumber" android:text="7" /></LinearLayout>
        <LinearLayout style="@style/CollabWidgetPreviewDay"><TextView style="@style/CollabWidgetPreviewDayNumber" android:text="8" /></LinearLayout>
        <LinearLayout style="@style/CollabWidgetPreviewDay"><TextView style="@style/CollabWidgetPreviewDayNumber" android:text="9" /></LinearLayout>
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
        <LinearLayout style="@style/CollabWidgetPreviewDay"><TextView style="@style/CollabWidgetPreviewDayNumber" android:text="10" /></LinearLayout>
        <LinearLayout style="@style/CollabWidgetPreviewDay"><TextView style="@style/CollabWidgetPreviewDayNumber" android:text="11" /><TextView style="@style/CollabWidgetPreviewChip" android:background="@drawable/collab_widget_preview_chip_rose" android:text="Review" /></LinearLayout>
        <LinearLayout style="@style/CollabWidgetPreviewDay"><TextView style="@style/CollabWidgetPreviewDayNumber" android:text="12" /></LinearLayout>
        <LinearLayout style="@style/CollabWidgetPreviewDay"><TextView style="@style/CollabWidgetPreviewDayNumber" android:text="13" /></LinearLayout>
        <LinearLayout style="@style/CollabWidgetPreviewDay"><TextView style="@style/CollabWidgetPreviewDayNumber" android:text="14" /></LinearLayout>
        <LinearLayout style="@style/CollabWidgetPreviewDay"><TextView style="@style/CollabWidgetPreviewDayNumber" android:text="15" /><TextView style="@style/CollabWidgetPreviewChip" android:background="@drawable/collab_widget_preview_chip_violet" android:text="Birthday" /></LinearLayout>
        <LinearLayout style="@style/CollabWidgetPreviewDay"><TextView style="@style/CollabWidgetPreviewDayNumber" android:text="16" /></LinearLayout>
    </LinearLayout>
</LinearLayout>
