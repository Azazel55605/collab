<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/CollabWidgetPreviewShell">

    <TextView
        style="@style/CollabWidgetPreviewHeader"
        android:layout_width="match_parent"
        android:layout_weight="0"
        android:text="Birthdays" />

    <LinearLayout
        style="@style/CollabWidgetPreviewCard"
        android:layout_marginTop="9dp">
        <View
            style="@style/CollabWidgetPreviewRail"
            android:background="@drawable/collab_widget_preview_rail_violet" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextView
                style="@style/CollabWidgetPreviewCardTitle"
                android:text="Alex Morgan" />
            <TextView
                style="@style/CollabWidgetPreviewCardDetail"
                android:text="In 4 days · Aug 5" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        style="@style/CollabWidgetPreviewCard"
        android:layout_marginTop="6dp">
        <View
            style="@style/CollabWidgetPreviewRail"
            android:background="@drawable/collab_widget_preview_rail_rose" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextView
                style="@style/CollabWidgetPreviewCardTitle"
                android:text="Sam Rivera" />
            <TextView
                style="@style/CollabWidgetPreviewCardDetail"
                android:text="In 12 days · Aug 13" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
