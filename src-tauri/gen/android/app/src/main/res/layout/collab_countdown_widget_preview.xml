<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/CollabWidgetPreviewShell">

    <TextView
        style="@style/CollabWidgetPreviewHeader"
        android:layout_width="match_parent"
        android:layout_weight="0"
        android:text="Countdowns" />

    <LinearLayout
        style="@style/CollabWidgetPreviewCard"
        android:layout_marginTop="9dp">
        <ImageView
            style="@style/CollabWidgetPreviewRail"
            android:background="@drawable/collab_widget_preview_rail_violet" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextView
                style="@style/CollabWidgetPreviewCardTitle"
                android:text="Release day" />
            <TextView
                style="@style/CollabWidgetPreviewCardDetail"
                android:text="In 12 days · Thu, Aug 13" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        style="@style/CollabWidgetPreviewCard"
        android:layout_marginTop="6dp">
        <ImageView
            style="@style/CollabWidgetPreviewRail"
            android:background="@drawable/collab_widget_preview_rail_cyan" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextView
                style="@style/CollabWidgetPreviewCardTitle"
                android:text="Quarter close" />
            <TextView
                style="@style/CollabWidgetPreviewCardDetail"
                android:text="In 29 days · Sun, Aug 30" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
