<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/CollabWidgetPreviewShell">

    <TextView
        style="@style/CollabWidgetPreviewHeader"
        android:layout_width="match_parent"
        android:layout_weight="0"
        android:text="Tasks" />

    <TextView
        style="@style/CollabWidgetPreviewSection"
        android:layout_marginTop="9dp"
        android:text="Overdue" />

    <LinearLayout
        style="@style/CollabWidgetPreviewCard"
        android:layout_marginTop="4dp"
        android:paddingLeft="6dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">
        <TextView
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginEnd="7dp"
            android:gravity="center"
            android:text="○"
            android:textColor="#FA416B"
            android:textSize="14sp" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextView
                style="@style/CollabWidgetPreviewCardTitle"
                android:text="Send the release notes" />
            <TextView
                style="@style/CollabWidgetPreviewCardDetail"
                android:text="Jul 30, 17:00 · Work" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        style="@style/CollabWidgetPreviewSection"
        android:layout_marginTop="8dp"
        android:text="Today" />

    <LinearLayout
        style="@style/CollabWidgetPreviewCard"
        android:layout_marginTop="4dp"
        android:paddingLeft="6dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">
        <TextView
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginEnd="7dp"
            android:gravity="center"
            android:text="○"
            android:textColor="#A174FF"
            android:textSize="14sp" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextView
                style="@style/CollabWidgetPreviewCardTitle"
                android:text="Review the design board" />
            <TextView
                style="@style/CollabWidgetPreviewCardDetail"
                android:text="Aug 1 · Assigned tasks" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
