<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/collab_widget_preview_background"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Sat, Aug 1"
            android:textColor="#E4E8EF"
            android:textSize="15sp"
            android:textStyle="bold" />
        <TextView
            android:layout_width="40dp"
            android:layout_height="34dp"
            android:background="@drawable/collab_widget_preview_accent"
            android:gravity="center"
            android:text="+"
            android:textColor="#0C0F16"
            android:textSize="22sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:text="●  Design review"
        android:textColor="#E4E8EF"
        android:textSize="13sp"
        android:textStyle="bold" />
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="17dp"
        android:text="09:30 · Event"
        android:textColor="#808693"
        android:textSize="11sp" />
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="●  Project follow-up"
        android:textColor="#E4E8EF"
        android:textSize="13sp"
        android:textStyle="bold" />
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="17dp"
        android:text="Today · Task"
        android:textColor="#808693"
        android:textSize="11sp" />
</LinearLayout>
