<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/CollabWidgetPreviewShell">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            style="@style/CollabWidgetPreviewHeader"
            android:text="August" />
        <TextView
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/collab_widget_preview_quiet_button"
            android:gravity="center"
            android:text="‹"
            android:textColor="#E4E8EF"
            android:textSize="18sp" />
        <TextView
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/collab_widget_preview_quiet_button"
            android:gravity="center"
            android:text="›"
            android:textColor="#E4E8EF"
            android:textSize="18sp" />
        <TextView
            style="@style/CollabWidgetPreviewAccentButton"
            android:layout_marginStart="6dp"
            android:text="＋" />
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:orientation="horizontal">
        <TextView style="@style/CollabWidgetPreviewWeekday" android:text="M" />
        <TextView style="@style/CollabWidgetPreviewWeekday" android:text="T" />
        <TextView style="@style/CollabWidgetPreviewWeekday" android:text="W" />
        <TextView style="@style/CollabWidgetPreviewWeekday" android:text="T" />
        <TextView style="@style/CollabWidgetPreviewWeekday" android:text="F" />
        <TextView style="@style/CollabWidgetPreviewWeekday" android:text="S" />
        <TextView style="@style/CollabWidgetPreviewWeekday" android:text="S" />
    </LinearLayout>

    <!-- Week rows stack the day cells and a bar lane, so a multi-day entry can
         be drawn as one run across the columns it covers. -->
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_marginTop="4dp" android:layout_weight="1">
        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal">
            <LinearLayout style="@style/CollabWidgetPreviewDay"><TextView style="@style/CollabWidgetPreviewDayNumber" android:text="27" android:textColor="#646A75" /></LinearLayout>
            <LinearLayout style="@style/CollabWidgetPreviewDay"><TextView style="@style/CollabWidgetPreviewDayNumber" android:text="28" android:textColor="#646A75" /></LinearLayout>
            <LinearLayout style="@style/CollabWidgetPreviewDay"><TextView style="@style/CollabWidgetPreviewDayNumber" android:text="29" android:textColor="#646A75" /></LinearLayout>
            <LinearLayout style="@style/CollabWidgetPreviewDay"><TextView style="@style/CollabWidgetPreviewDayNumber" android:text="30" android:textColor="#646A75" /></LinearLayout>
            <LinearLayout style="@style/CollabWidgetPreviewDay"><TextView style="@style/CollabWidgetPreviewDayNumber" android:text="31" android:textColor="#646A75" /></LinearLayout>
            <LinearLayout style="@style/CollabWidgetPreviewDay"><TextView style="@style/CollabWidgetPreviewDayNumber" android:background="@drawable/collab_widget_preview_accent" android:text="1" android:textColor="#0C0F16" /></LinearLayout>
            <LinearLayout style="@style/CollabWidgetPreviewDay"><TextView style="@style/CollabWidgetPreviewDayNumber" android:text="2" /></LinearLayout>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <View android:layout_width="match_parent" android:layout_height="20dp" />
            <LinearLayout style="@style/CollabWidgetPreviewLane">
                <View style="@style/CollabWidgetPreviewLaneGap" />
                <View style="@style/CollabWidgetPreviewLaneGap" />
                <View style="@style/CollabWidgetPreviewLaneGap" />
                <TextView style="@style/CollabWidgetPreviewBar" android:background="@drawable/collab_widget_preview_bar_violet" android:text="Planning" />
                <View style="@style/CollabWidgetPreviewBar" android:background="@drawable/collab_widget_preview_bar_violet" />
                <View style="@style/CollabWidgetPreviewBar" android:background="@drawable/collab_widget_preview_bar_violet" />
                <View style="@style/CollabWidgetPreviewLaneGap" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal">
            <LinearLayout style="@style/CollabWidgetPreviewDay"><TextView style="@style/CollabWidgetPreviewDayNumber" android:text="3" /></LinearLayout>
            <LinearLayout style="@style/CollabWidgetPreviewDay"><TextView style="@style/CollabWidgetPreviewDayNumber" android:text="4" /></LinearLayout>
            <LinearLayout style="@style/CollabWidgetPreviewDay"><TextView style="@style/CollabWidgetPreviewDayNumber" android:text="5" /></LinearLayout>
            <LinearLayout style="@style/CollabWidgetPreviewDay"><TextView style="@style/CollabWidgetPreviewDayNumber" android:text="6" /></LinearLayout>
            <LinearLayout style="@style/CollabWidgetPreviewDay"><TextView style="@style/CollabWidgetPreviewDayNumber" android:text="7" /></LinearLayout>
            <LinearLayout style="@style/CollabWidgetPreviewDay"><TextView style="@style/CollabWidgetPreviewDayNumber" android:text="8" /></LinearLayout>
            <LinearLayout style="@style/CollabWidgetPreviewDay"><TextView style="@style/CollabWidgetPreviewDayNumber" android:text="9" /></LinearLayout>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <View android:layout_width="match_parent" android:layout_height="20dp" />
            <LinearLayout style="@style/CollabWidgetPreviewLane">
                <TextView style="@style/CollabWidgetPreviewChip" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/collab_widget_preview_chip_rose" android:gravity="center_vertical" android:text="Design" />
                <View style="@style/CollabWidgetPreviewLaneGap" />
                <View style="@style/CollabWidgetPreviewLaneGap" />
                <TextView style="@style/CollabWidgetPreviewBar" android:background="@drawable/collab_widget_preview_bar_cyan" android:text="Workshop" />
                <View style="@style/CollabWidgetPreviewBar" android:background="@drawable/collab_widget_preview_bar_cyan" />
                <View style="@style/CollabWidgetPreviewLaneGap" />
                <View style="@style/CollabWidgetPreviewLaneGap" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal">
            <LinearLayout style="@style/CollabWidgetPreviewDay"><TextView style="@style/CollabWidgetPreviewDayNumber" android:text="10" /></LinearLayout>
            <LinearLayout style="@style/CollabWidgetPreviewDay"><TextView style="@style/CollabWidgetPreviewDayNumber" android:text="11" /></LinearLayout>
            <LinearLayout style="@style/CollabWidgetPreviewDay"><TextView style="@style/CollabWidgetPreviewDayNumber" android:text="12" /></LinearLayout>
            <LinearLayout style="@style/CollabWidgetPreviewDay"><TextView style="@style/CollabWidgetPreviewDayNumber" android:text="13" /></LinearLayout>
            <LinearLayout style="@style/CollabWidgetPreviewDay"><TextView style="@style/CollabWidgetPreviewDayNumber" android:text="14" /></LinearLayout>
            <LinearLayout style="@style/CollabWidgetPreviewDay"><TextView style="@style/CollabWidgetPreviewDayNumber" android:text="15" /></LinearLayout>
            <LinearLayout style="@style/CollabWidgetPreviewDay"><TextView style="@style/CollabWidgetPreviewDayNumber" android:text="16" /></LinearLayout>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <View android:layout_width="match_parent" android:layout_height="20dp" />
            <LinearLayout style="@style/CollabWidgetPreviewLane">
                <View style="@style/CollabWidgetPreviewLaneGap" />
                <TextView style="@style/CollabWidgetPreviewChip" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/collab_widget_preview_chip_violet" android:gravity="center_vertical" android:text="Review" />
                <View style="@style/CollabWidgetPreviewLaneGap" />
                <View style="@style/CollabWidgetPreviewLaneGap" />
                <View style="@style/CollabWidgetPreviewLaneGap" />
                <View style="@style/CollabWidgetPreviewLaneGap" />
                <View style="@style/CollabWidgetPreviewLaneGap" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
