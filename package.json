{
  "name": "collab",
  "private": true,
  "version": "0.7.1",
  "packageManager": "pnpm@11.7.0",
  "type": "module",
  "engines": {
    "node": ">=20.19.0",
    "pnpm": ">=10"
  },
  "volta": {
    "node": "22.23.2",
    "pnpm": "11.7.0"
  },
  "browserslist": {
    "production": [
      "chrome >= 111",
      "edge >= 111",
      "firefox >= 128",
      "safari >= 16.4",
      "android >= 111",
      "not dead"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "scripts": {
    "versions:sync": "node scripts/sync-versions.mjs",
    "versions:check": "node scripts/sync-versions.mjs --check",
    "preformat": "node scripts/fix-imports.mjs",
    "format": "prettier --write \"src/**/*.{ts,tsx,json,css}\" \"apps/*/src/**/*.{ts,tsx,json,css}\" \"scripts/**/*.{ts,mjs}\" \"*.{json,md}\" \"docs/**/*.md\" \"index.html\" \"apps/*/index.html\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,json,css}\" \"apps/*/src/**/*.{ts,tsx,json,css}\" \"scripts/**/*.{ts,mjs}\" \"*.{json,md}\" \"docs/**/*.md\" \"index.html\" \"apps/*/index.html\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "rust:boundaries": "node scripts/check-rust-crate-boundaries.mjs",
    "dev": "node scripts/prepare-ocr-assets.mjs && vite",
    "build": "node scripts/prepare-ocr-assets.mjs && tsc && vite build",
    "prepare:ocr": "node scripts/prepare-ocr-assets.mjs",
    "mobile:dev": "vite --config apps/mobile-android/vite.config.ts",
    "mobile:build": "node scripts/mobile-build-frontend.mjs",
    "mobile:test": "vitest run --config apps/mobile-android/vitest.config.ts",
    "android:init": "node scripts/tauri-command.mjs android init --config src-tauri/tauri.android.conf.json",
    "android:dev": "node scripts/tauri-command.mjs android dev --config src-tauri/tauri.android.conf.json",
    "android:build": "node scripts/tauri-command.mjs android build --apk --target aarch64 --config src-tauri/tauri.android.conf.json",
    "android:build:universal": "node scripts/tauri-command.mjs android build --apk --config src-tauri/tauri.android.conf.json",
    "android:build:debug": "node scripts/tauri-command.mjs android build --debug --apk --target aarch64 --config src-tauri/tauri.android.conf.json",
    "android:build:debug:x86_64": "node scripts/tauri-command.mjs android build --debug --apk --target x86_64 --config src-tauri/tauri.android.conf.json",
    "android:build:debug:universal": "node scripts/tauri-command.mjs android build --debug --apk --config src-tauri/tauri.android.conf.json",
    "android:build:aab": "node scripts/tauri-command.mjs android build --aab --config src-tauri/tauri.android.conf.json",
    "preview": "vite preview",
    "test": "vitest run",
    "admin:build": "vite build --config apps/admin-web/vite.config.ts && tsc --noEmit -p apps/admin-web/tsconfig.json",
    "admin:test": "vitest run --config apps/admin-web/vite.config.ts",
    "admin:dev": "vite --config apps/admin-web/vite.config.ts",
    "test:watch": "vitest",
    "server:backup": "./scripts/server-backups.sh backup",
    "server:backups": "./scripts/server-backups.sh",
    "server:backup:schedule": "./scripts/server-backups.sh schedule",
    "server:backup:list": "./scripts/server-backups.sh list",
    "server:backup:smoke": "./scripts/server-backups.sh smoke-test",
    "server:upgrade:preflight": "./scripts/server-backups.sh upgrade-preflight",
    "server:sessions:revoke": "./scripts/server-revoke-sessions.sh",
    "server:security:scan": "./scripts/server-security-scan.sh",
    "server:load-test": "./scripts/server-load-test.sh",
    "server:image:build": "./scripts/server-container-build.sh",
    "desktop:release:check": "node scripts/check-release-version.mjs --target desktop",
    "mobile:release:check": "node scripts/check-release-version.mjs --target mobile",
    "admin:release:check": "node scripts/check-release-version.mjs --target admin-web",
    "server:release:check": "node scripts/check-release-version.mjs --target server",
    "server:restore": "./scripts/server-backups.sh restore",
    "tauri": "node scripts/tauri-command.mjs"
  },
  "dependencies": {
    "@azurity/pure-nerd-font": "^3.0.5",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.9",
    "@crabnebula/tauri-plugin-drag": "^2.1.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/fira-code": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@lezer/highlight": "^1.2.3",
    "@lezer/markdown": "^1.7.2",
    "@m234/nerd-fonts": "^0.5.2",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-fs": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-updater": "^2",
    "@tesseract.js-data/eng": "^1.0.0",
    "@types/katex": "^0.16.8",
    "@types/markdown-it": "^14.1.2",
    "@xyflow/react": "^12.11.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "d3": "^7.9.0",
    "date-fns": "^4.4.0",
    "diff": "^7.0.0",
    "dompurify": "^3.4.14",
    "highlight.js": "^11.12.0",
    "ical.js": "2.2.1",
    "katex": "^0.18.4",
    "lucide-react": "^1.34.0",
    "markdown-it": "^14.2.0",
    "markdown-it-anchor": "^9.2.1",
    "markdown-it-container": "^4.0.0",
    "markdown-it-deflist": "^3.0.0",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-mark": "^4.0.0",
    "markdown-it-sub": "^2.0.0",
    "markdown-it-sup": "^2.0.0",
    "markdown-it-task-lists": "^2.1.1",
    "markdown-it-texmath": "^1.0.0",
    "mermaid": "^11.17.2",
    "nerdamer": "^1.1.13",
    "next-themes": "^0.4.6",
    "pdfjs-dist": "^6.2.108",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.2.8",
    "react-resizable-panels": "^4.12.3",
    "simple-icons": "^16.28.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tesseract.js": "^7.0.0",
    "tesseract.js-core": "7.0.0",
    "three": "^0.185.1",
    "tw-animate-css": "^1.4.0",
    "y-codemirror.next": "^0.3.6",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.32",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2",
    "@testing-library/react": "^16.3.2",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/d3": "^7.4.3",
    "@types/diff": "^7.0.0",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^4.6.0",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "globals": "^17.11.0",
    "jsdom": "^29.1.1",
    "perfect-freehand": "^1.2.3",
    "prettier": "^3.9.6",
    "shadcn": "^4.19.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^7.3.5",
    "vitest": "^4.1.11"
  }
}
