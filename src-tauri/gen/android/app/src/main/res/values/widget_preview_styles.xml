<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="CollabWidgetPreviewWeekday">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">#808693</item>
        <item name="android:textSize">9sp</item>
    </style>
    <style name="CollabWidgetPreviewDay">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">1dp</item>
        <item name="android:background">@drawable/collab_widget_preview_surface</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">3dp</item>
    </style>
    <style name="CollabWidgetPreviewDayNumber">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center_horizontal</item>
        <item name="android:textColor">#E4E8EF</item>
        <item name="android:textSize">10sp</item>
    </style>
    <style name="CollabWidgetPreviewChip">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:ellipsize">end</item>
        <item name="android:maxLines">1</item>
        <item name="android:paddingLeft">2dp</item>
        <item name="android:paddingRight">2dp</item>
        <item name="android:textColor">#0C0F16</item>
        <item name="android:textSize">7sp</item>
    </style>
</resources>
