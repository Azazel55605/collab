<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/CollabWidgetPreviewShell">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            style="@style/CollabWidgetPreviewHeader"
            android:text="Sat, Aug 1" />
        <TextView
            style="@style/CollabWidgetPreviewAccentButton"
            android:text="＋" />
    </LinearLayout>

    <TextView
        style="@style/CollabWidgetPreviewSection"
        android:layout_marginTop="9dp"
        android:text="Today" />

    <LinearLayout
        style="@style/CollabWidgetPreviewCard"
        android:layout_marginTop="4dp">
        <View
            style="@style/CollabWidgetPreviewRail"
            android:background="@drawable/collab_widget_preview_rail_violet" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextView
                style="@style/CollabWidgetPreviewCardTitle"
                android:text="Design review" />
            <TextView
                style="@style/CollabWidgetPreviewCardDetail"
                android:text="09:30 · Event" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        style="@style/CollabWidgetPreviewCard"
        android:layout_marginTop="6dp">
        <View
            style="@style/CollabWidgetPreviewRail"
            android:background="@drawable/collab_widget_preview_rail_cyan" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextView
                style="@style/CollabWidgetPreviewCardTitle"
                android:text="Project follow-up" />
            <TextView
                style="@style/CollabWidgetPreviewCardDetail"
                android:text="Today · Task" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
