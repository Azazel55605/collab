<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/CollabWidgetPreviewShell">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            style="@style/CollabWidgetPreviewHeader"
            android:text="Sync" />
        <TextView
            style="@style/CollabWidgetPreviewAccentButton"
            android:text="⟳" />
    </LinearLayout>

    <LinearLayout
        style="@style/CollabWidgetPreviewCard"
        android:layout_marginTop="9dp">
        <ImageView
            style="@style/CollabWidgetPreviewRail"
            android:background="@drawable/collab_widget_preview_rail_violet" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextView
                style="@style/CollabWidgetPreviewCardTitle"
                android:text="Syncing…" />
            <TextView
                style="@style/CollabWidgetPreviewCardDetail"
                android:text="2 vaults · Synced 5 min ago" />
        </LinearLayout>
    </LinearLayout>

    <!-- Quantised progress track, matching SyncProgressBar. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">
        <ImageView style="@style/CollabWidgetPreviewProgressFilled" />
        <ImageView style="@style/CollabWidgetPreviewProgressFilled" />
        <ImageView style="@style/CollabWidgetPreviewProgressFilled" />
        <ImageView style="@style/CollabWidgetPreviewProgressFilled" />
        <ImageView style="@style/CollabWidgetPreviewProgressFilled" />
        <ImageView style="@style/CollabWidgetPreviewProgressFilled" />
        <ImageView style="@style/CollabWidgetPreviewProgressEmpty" />
        <ImageView style="@style/CollabWidgetPreviewProgressEmpty" />
        <ImageView style="@style/CollabWidgetPreviewProgressEmpty" />
        <ImageView style="@style/CollabWidgetPreviewProgressEmpty" />
    </LinearLayout>

    <LinearLayout
        style="@style/CollabWidgetPreviewCard"
        android:layout_marginTop="8dp">
        <ImageView
            style="@style/CollabWidgetPreviewRail"
            android:background="@drawable/collab_widget_preview_rail_danger" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextView
                style="@style/CollabWidgetPreviewCardTitle"
                android:text="Team vault" />
            <TextView
                style="@style/CollabWidgetPreviewCardDetail"
                android:text="1 change needs attention" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        style="@style/CollabWidgetPreviewCard"
        android:layout_marginTop="6dp">
        <ImageView
            style="@style/CollabWidgetPreviewRail"
            android:background="@drawable/collab_widget_preview_rail_muted" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextView
                style="@style/CollabWidgetPreviewCardTitle"
                android:text="Notes" />
            <TextView
                style="@style/CollabWidgetPreviewCardDetail"
                android:text="Synced 5 min ago" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
